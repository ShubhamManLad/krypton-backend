{
  "info": {
    "_postman_id": "7a8b9c0d-1e2f-3a4b-5c6d-7e8f9a0b1c2d",
    "name": "Krypton Chat API (Zero-Storage Architecture)",
    "description": "Postman Collection for Krypton Zero-Storage Ephemeral Relay & Presence Broker",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "wsUrl",
      "value": "ws://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "recipientId",
      "value": "",
      "type": "string"
    },
    {
      "key": "mediaId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health-check",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health-check"
          ]
        },
        "description": "Check if the server is up and responding."
      },
      "response": []
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User 1 (Alice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "    }",
                  "    if (json.userId) {",
                  "        pm.collectionVariables.set('userId', json.userId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Registers a new user and automatically updates the collection `token` and `userId` variables on success (200)."
          },
          "response": []
        },
        {
          "name": "Register User 2 (Bob)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.userId) {",
                  "        pm.collectionVariables.set('recipientId', json.userId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"bob\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Registers a second user and sets `recipientId` variable for testing direct messages."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "    }",
                  "    if (json.userId) {",
                  "        pm.collectionVariables.set('userId', json.userId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in an existing user and returns JWT token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users & Public Keys",
      "item": [
        {
          "name": "Get All Users (Directory)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Fetches all registered users with real-time online status and their E2EE public keys."
          },
          "response": []
        },
        {
          "name": "Register/Update My Public Key",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"publicKey\": \"MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me/public-key",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me",
                "public-key"
              ]
            },
            "description": "Registers or rotates the authenticated user's E2EE public key in the directory."
          },
          "response": []
        },
        {
          "name": "Get Partner Public Key",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{recipientId}}/public-key",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{recipientId}}",
                "public-key"
              ]
            },
            "description": "Fetches a partner user's public key by their UUID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Media (Ephemeral Burn-on-Read)",
      "item": [
        {
          "name": "Upload Ephemeral Media",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.id) {",
                  "        pm.collectionVariables.set('mediaId', json.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII=\",\n  \"contentType\": \"image/png\",\n  \"fileName\": \"sample.png\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/media",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "media"
              ]
            },
            "description": "Uploads an encrypted Base64 string payload and returns a unique media UUID."
          },
          "response": []
        },
        {
          "name": "Get & Burn Ephemeral Media by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/media/{{mediaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "media",
                "{{mediaId}}"
              ]
            },
            "description": "Fetches the Base64 media data and immediately deletes it from the server (Burn-on-Read)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "WebSocket (Zero-Storage Relay Reference)",
      "item": [
        {
          "name": "1. Connect URL & Handshake",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{wsUrl}}/chat?token={{token}}",
              "host": [
                "{{wsUrl}}"
              ],
              "path": [
                "chat"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "description": "JWT token issued by /auth/login or /auth/register"
                }
              ]
            },
            "description": "### WebSocket Connection URL\nConnect to: `ws://localhost:8080/chat?token={{token}}`\n\n### Events Sent Immediately on Connect:\n- Active users list to connected client: `{\"type\": \"presence\", \"activeUsers\": [...]}`\n- Broadcast to other connected clients: `{\"type\": \"user_online\", \"userId\": \"<uuid>\", \"username\": \"<name>\"}`"
          },
          "response": []
        }
      ]
    }
  ]
}
