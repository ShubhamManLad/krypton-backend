      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "wsUrl",
      "value": "ws://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "recipientId",
      "value": "",
      "type": "string"
    },
    {
      "key": "conversationId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health-check",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health-check"
          ]
        },
        "description": "Check if the server is up and responding."
      },
      "response": []
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User 1 (Alice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "    }",
                  "    if (json.userId) {",
                  "        pm.collectionVariables.set('userId', json.userId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Registers a new user and automatically updates the collection `token` and `userId` variables on success (200)."
          },
          "response": []
        },
        {
          "name": "Register User 2 (Bob)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.userId) {",
                  "        pm.collectionVariables.set('recipientId', json.userId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"bob\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Registers a second user and sets `recipientId` variable for testing direct messages."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "    }",
                  "    if (json.userId) {",
                  "        pm.collectionVariables.set('userId', json.userId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in an existing user and returns JWT token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Active Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "active"
              ]
            },
            "description": "Fetches a list of all currently active/online users in the system."
          },
          "response": []
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Fetches a list of all registered users in the system, excluding the caller, along with their active/online status."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Conversations",
      "item": [
        {
          "name": "List Active Conversations",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conversations"
              ]
            },
            "description": "Fetches all active conversations for the authenticated user sorted by latest message activity DESC."
          },
          "response": []
        },
        {
          "name": "Get or Create Conversation with Recipient",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversations/with/{{recipientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conversations",
                "with",
                "{{recipientId}}"
              ]
            },
            "description": "Finds existing 1:1 conversation or creates a new one between the caller and the recipient user ID."
          },
          "response": []
        },
        {
          "name": "Get Messages with Partner ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversations/messages?partnerId={{recipientId}}&limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conversations",
                "messages"
              ],
              "query": [
                {
                  "key": "partnerId",
                  "value": "{{recipientId}}",
                  "description": "Partner User ID"
                },
                {
                  "key": "before",
                  "value": "2026-08-15T12:00:00Z",
                  "description": "Optional ISO-8601 timestamp",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Optional limit (default 50)"
                }
              ]
            },
            "description": "Fetches messages directly by partner user ID."
          },
          "response": []
        },
        {
          "name": "Get Conversation Messages by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversations/{{conversationId}}/messages?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conversations",
                "{{conversationId}}",
                "messages"
              ],
              "query": [
                {
                  "key": "before",
                  "value": "2026-08-15T12:00:00Z",
                  "description": "Optional ISO-8601 timestamp to fetch messages before this point",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Optional limit (default 50)"
                }
              ]
            },
        {
          "name": "Mark Conversation as Read",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversations/{{conversationId}}/read",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conversations",
                "{{conversationId}}",
                "read"
              ]
            },
            "description": "Marks all messages sent to the authenticated user in the conversation as READ and dispatches read receipt over WebSocket."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Media",
      "item": [
        {
          "name": "Upload Media (Encrypted Base64)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.id) {",
                  "        pm.collectionVariables.set('mediaId', json.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII=\",\n  \"contentType\": \"image/png\",\n  \"fileName\": \"sample.png\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/media",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "media"
              ]
            },
            "description": "Uploads an encrypted Base64 string payload and returns a unique media ID/UUID."
          },
          "response": []
        },
        {
          "name": "Get Media by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/media/{{mediaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "media",
                "{{mediaId}}"
              ]
            },
            "description": "Fetches the Base64 media data payload using the media ID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "WebSocket (Reference & Documentation)",
      "item": [
        {
          "name": "1. Connect URL & Handshake",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{wsUrl}}/chat?token={{token}}",
              "host": [
                "{{wsUrl}}"
              ],
              "path": [
                "chat"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "description": "JWT token issued by /auth/login or /auth/register"
                }
              ]
            },
            "description": "### WebSocket Connection URL\nUse Postman's WebSocket Request feature or any WebSocket client to connect to:\n`ws://localhost:8080/chat?token={{token}}`\n\n- Rejects with code 4001 if token is invalid or missing.\n- Automatically registers presence and broadcasts active users list."
          },
          "response": []
        },
        {
          "name": "2. Client Send Message Payload (Sample)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"message\",\n  \"recipientId\": \"{{recipientId}}\",\n  \"content\": \"Hello there!\",\n  \"clientMsgId\": \"{{$guid}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/websocket/sample-send-message",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "websocket",
                "sample-send-message"
              ]
            },
            "description": "### Sample JSON payload to send over WebSocket connection:\n```json\n{\n  \"type\": \"message\",\n  \"recipientId\": \"<uuid>\",\n  \"content\": \"Hello there!\",\n  \"clientMsgId\": \"<uuid>\"\n}\n```\n\n### Expected Server Ack to Sender:\n```json\n{\n  \"type\": \"ack\",\n  \"clientMsgId\": \"<same-uuid>\",\n  \"serverMsgId\": \"<server-uuid>\"\n}\n```\n\n### Expected Server Push to Recipient:\n```json\n{\n  \"type\": \"message\",\n  \"id\": \"<server-uuid>\",\n  \"conversationId\": \"<uuid>\",\n  \"senderId\": \"<uuid>\",\n  \"content\": \"Hello there!\",\n  \"sentAt\": \"2026-08-15T10:30:00Z\",\n  \"clientMsgId\": \"<client-uuid>\"\n}\n```"
          },
          "response": []
        }
      ]
    }
  ]
}
