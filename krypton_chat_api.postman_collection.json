{
  "info": {
    "_postman_id": "7a8b9c0d-1e2f-3a4b-5c6d-7e8f9a0b1c2d",
    "name": "Krypton Chat API",
    "description": "Postman Collection for Krypton Chat Backend (Quarkus REST & WebSockets)",
